generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  organization String?
  email        String   @unique
  mobile       String?
  street       String?
  locality     String?
  state        String?
  district     String?
  pincode      String?
  isVerified   Boolean  @default(false)
  role         String   @default("user")
  createdAt    DateTime @default(now())
  emailOtps    EmailOtp[]
  orders       Order[]
}

model EmailOtp {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?
}

model Service {
  id           String   @id @default(cuid())
  title        String
  description  String
  price        Float
  gstRate      Float    @default(0)
  checklist    String?
  active       Boolean  @default(true)
}

model Order {
  id                String   @id @default(cuid())
  user              User     @relation(fields: [userId], references: [id])
  userId            String
  createdAt         DateTime @default(now())
  amount            Float
  tax               Float
  total             Float
  paymentProviderId String?
  paymentStatus     String   @default("PENDING")
  items             String
  documents         Document[]
}

model Document {
  id        String   @id @default(cuid())
  order     Order    @relation(fields: [orderId], references: [id])
  orderId   String
  serviceId String?
  userId    String?
  filename  String
  s3Key     String?
  uploadedAt DateTime @default(now())
}

model Law {
  id           String   @id @default(cuid())
  title        String
  content      String
  state        String?
  effectiveDate DateTime?
  tags         String?
  attachments  String?
  createdAt    DateTime @default(now())
}

model MinimumWage {
  id           String   @id @default(cuid())
  state        String
  effectiveDate DateTime
  wageJson     String
  createdAt    DateTime @default(now())
}
