generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}
enum Role {
  USER
  ADMIN
  MANAGER
  ACCOUNTANT
}

enum BillingInterval {
  MONTH
  YEAR
}

model User {
  id           String   @id @default(cuid())
  name         String
  organization String?
  email        String   @unique
  mobile       String?
  street       String?
  locality     String?
  state        String?
  district     String?
  pincode      String?
  isVerified   Boolean  @default(false)
  role         Role     @default(USER)
  billingInfo  Json?
  createdAt    DateTime @default(now())
  emailOtps    EmailOtp[]
  orders       Order[]
  subscriptions Subscription[]
}

model EmailOtp {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?
}

model Service {
  id           String   @id @default(cuid())
  title        String
  description  String
  price        Float
  gstRate      Float    @default(0)
  checklist    String?
  isRecurring  Boolean  @default(false)
  billingInterval BillingInterval?
  consultancyCharges Float?  
  discountPercent Float? @default(0)
  active       Boolean  @default(true)
}

model Order {
  id                String   @id @default(cuid())
  user              User     @relation(fields: [userId], references: [id])
  userId            String
  createdAt         DateTime @default(now())
  amount            Float
  tax               Float
  total             Float
  paymentProviderId String?
  paymentStatus     String   @default("PENDING")
  items             String
  documents         Document[]
}

model Coupon {
  id        String   @id @default(cuid())
  code      String   @unique
  amount    Float?   // fixed amount off
  percent   Float?   // percentage off
  active    Boolean  @default(true)
  expiresAt DateTime?
}

model Cart {
  id      String @id @default(cuid())
  user    User   @relation(fields: [userId], references: [id])
  userId  String
  items   Json
  updatedAt DateTime @updatedAt
}

model Subscription {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id])
  userId     String
  serviceId  String
  status     String   @default("ACTIVE")
  startedAt  DateTime @default(now())
  nextBilling DateTime?
}

model Document {
  id        String   @id @default(cuid())
  order     Order    @relation(fields: [orderId], references: [id])
  orderId   String
  serviceId String?
  userId    String?
  filename  String
  s3Key     String?
  uploadedAt DateTime @default(now())
}

model Law {
  id           String   @id @default(cuid())
  title        String
  content      String
  state        String?
  effectiveDate DateTime?
  tags         String?
  attachments  String?
  createdAt    DateTime @default(now())
}

model MinimumWage {
  id           String   @id @default(cuid())
  state        String
  effectiveDate DateTime
  wageJson     String
  createdAt    DateTime @default(now())
}
