# Example environment variables for Legal Compliance & Payroll Services
# Copy this file to .env.local (or .env.production) and fill in real values.

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/dbname?schema=public"

# Site
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# JWT / Auth
JWT_SECRET="changeme_to_a_long_random_secret"
ADMIN_EMAIL="admin@example.com"

# SMTP (Nodemailer)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-pass
SMTP_FROM="Example <no-reply@example.com>"

# PayU (India) - test keys for sandbox / staging
PAYU_MERCHANT_ID=
PAYU_MERCHANT_KEY=
PAYU_MERCHANT_SALT=
PAYU_ENV=TEST # or PROD

# AWS S3 (for file uploads)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=

# Vercel / CI (optional)
VERCEL_TOKEN=

# Other
NODE_ENV=development
# Rename to .env.local and fill values
DATABASE_URL=postgresql://user:password@localhost:5432/legalapp
NEXT_PUBLIC_PAYU_MERCHANT_KEY=your_payu_merchant_key
PAYU_MERCHANT_SALT=your_payu_salt
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
NEXTAUTH_SECRET=replace_with_random_value
JWT_SECRET=replace_with_random_value_for_jwt
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=your_aws_region
S3_BUCKET=your_s3_bucket_name
